  "source": {
    "entry": "bankroll_vault.ark",
    "files": {
      "bankroll_vault.ark": "pragma arkade ^0.1.0;\n\ncontract BankrollVault(\n  bytes32 controlTxid, int controlGidx,\n  bytes32 shareTxid, int shareGidx\n) {\n  const int MAX_NAV = 1000000;\n  const int MAX_SUPPLY = 1000000000000;\n  const int DUST = 330;\n\n  private function supply() int {\n    require(this.activeInputIndex == 0, \"vault input\");\n    require(tx.numInputs == 2, \"one member input\");\n    require(tx.inputs[1].script != tx.input.current.script, \"one vault\");\n    require(controlTxid != shareTxid || controlGidx != shareGidx, \"distinct assets\");\n    require(controlGidx >= 0 && controlGidx <= 65535, \"control index\");\n    require(shareGidx >= 0 && shareGidx <= 65535, \"share index\");\n    require(tx.input.current.value >= DUST && tx.input.current.value <= MAX_NAV, \"vault NAV\");\n    require(tx.inputs[1].value >= DUST && tx.inputs[1].value <= 2100000000000000, \"member carrier\");\n    require(tx.inputs[0].assets.length == 1, \"vault assets\");\n    require(tx.inputs[0].assets.lookup(controlTxid, controlGidx) == 1, \"control unit\");\n    require(tx.assetGroups.length == 2, \"asset groups\");\n    let control = tx.assetGroups.find(controlTxid, controlGidx);\n    let shares = tx.assetGroups.find(shareTxid, shareGidx);\n    require(!control.isFresh && !shares.isFresh, \"existing assets\");\n    require(!control.hasControl && !shares.hasControl, \"no issuance reference\");\n    require(control.numInputs == 1 && control.sumInputs == 1, \"control input count\");\n    require(control.inputs[0].type == 1 && control.inputs[0].index == 0, \"local control input\");\n    bytes previous = tx.inputs[0].packet(32);\n    require(size(previous) >= 1 && size(previous) <= 6, \"supply encoding size\");\n    int issued = bin2num(previous);\n    require(issued > 0 && issued <= MAX_SUPPLY, \"share supply\");\n    require(previous == bytes(issued), \"minimal supply encoding\");\n    return issued;\n  }\n\n  private function continueVault(int nextNAV, int nextSupply) {\n    require(tx.numOutputs == 4, \"continuation outputs\");\n    require(tx.outputs[0].script == tx.input.current.script, \"vault continuation\");\n    require(tx.outputs[0].value == nextNAV, \"next NAV\");\n    require(tx.outputs[0].assets.length == 1, \"continuation assets\");\n    require(tx.outputs[0].assets.lookup(controlTxid, controlGidx) == 1, \"continue control\");\n    let control = tx.assetGroups.find(controlTxid, controlGidx);\n    require(control.numOutputs == 1 && control.sumOutputs == 1, \"control preserved\");\n    require(control.outputs[0].index == 0, \"control destination\");\n    require(tx.packet(32) == bytes(nextSupply), \"next share supply\");\n    require(tx.outputs[1].script == tx.inputs[1].script, \"member destination\");\n    @allow(output-script-unchecked, \"only zero-valued extension and anchor outputs are allowed\")\n    require(tx.outputs[2].value == 0 && tx.outputs[3].value == 0, \"no hidden value\");\n  }\n\n  @allow(unsigned-spend-path, \"the control-bearing input and the member's signed funding input authorize the pinned outputs\")\n  function subscribe(int deposit, int minShares) {\n    int issued = supply();\n    int nav = tx.input.current.value;\n    require(deposit > 0 && deposit <= MAX_NAV - nav, \"deposit bound\");\n    require(minShares > 0 && minShares <= MAX_SUPPLY, \"minimum shares\");\n    require(tx.inputs[1].assets.length == 0, \"plain funding input\");\n    require(tx.inputs[1].value >= deposit + DUST, \"member change carrier\");\n    int minted = deposit * issued / nav;\n    require(minted > 0 && minted >= minShares, \"share quote\");\n    require(minted <= MAX_SUPPLY - issued, \"supply limit\");\n    continueVault(nav + deposit, issued + minted);\n    require(tx.outputs[1].value == tx.inputs[1].value - deposit, \"member change\");\n    require(tx.outputs[1].assets.length == 1, \"member share asset\");\n    require(tx.outputs[1].assets.lookup(shareTxid, shareGidx) == minted, \"minted shares\");\n    let shares = tx.assetGroups.find(shareTxid, shareGidx);\n    require(shares.numInputs == 0 && shares.sumInputs == 0, \"no share inputs\");\n    require(shares.numOutputs == 1 && shares.sumOutputs == minted, \"exact mint\");\n    require(shares.outputs[0].index == 1, \"share destination\");\n  }\n\n  @allow(unsigned-spend-path, \"the member spends their shares and both the redemption and remaining shares return to that input's script\")\n  function redeem(int burnShares, int minSats) {\n    int issued = supply();\n    int nav = tx.input.current.value;\n    require(burnShares > 0 && burnShares <= issued, \"burn bound\");\n    require(minSats > 0 && minSats <= MAX_NAV, \"minimum sats\");\n    require(tx.inputs[1].assets.length == 1, \"member share input\");\n    int held = tx.inputs[1].assets.lookup(shareTxid, shareGidx);\n    require(held >= burnShares && held <= issued, \"member shares\");\n    let shares = tx.assetGroups.find(shareTxid, shareGidx);\n    require(shares.numInputs == 1 && shares.sumInputs == held, \"exact share input\");\n    require(shares.inputs[0].type == 1 && shares.inputs[0].index == 1, \"local share input\");\n    int payout = burnShares * nav / issued;\n    require(payout > 0 && payout >= minSats, \"redemption quote\");\n    int nextSupply = issued - burnShares;\n    int remaining = held - burnShares;\n    require(shares.sumOutputs == remaining, \"exact share burn\");\n    if (nextSupply == 0) {\n      require(tx.numOutputs == 3, \"close outputs\");\n      require(tx.outputs[0].script == tx.inputs[1].script, \"final member\");\n      require(tx.outputs[0].value == nav + tx.inputs[1].value, \"final payout\");\n      require(tx.outputs[0].assets.length == 0, \"close assets\");\n      require(tx.outputs[1].value == 0 && tx.outputs[2].value == 0, \"no hidden value\");\n      let control = tx.assetGroups.find(controlTxid, controlGidx);\n      require(control.numOutputs == 0 && control.sumOutputs == 0, \"retire control\");\n      require(shares.numOutputs == 0, \"retire shares\");\n      require(!tx.packet.has(32), \"retired state\");\n    } else {\n      require(nav - payout >= DUST, \"remaining vault carrier\");\n      continueVault(nav - payout, nextSupply);\n      require(tx.outputs[1].value == tx.inputs[1].value + payout, \"member payout\");\n      if (remaining == 0) {\n        require(shares.numOutputs == 0, \"no share change\");\n        require(tx.outputs[1].assets.length == 0, \"no member assets\");\n      } else {\n        require(shares.numOutputs == 1, \"one share change\");\n        require(shares.outputs[0].index == 1, \"share change destination\");\n        require(tx.outputs[1].assets.length == 1, \"member share change\");\n        require(tx.outputs[1].assets.lookup(shareTxid, shareGidx) == remaining, \"remaining shares\");\n      }\n    }\n  }\n}\n"
    }
  },
