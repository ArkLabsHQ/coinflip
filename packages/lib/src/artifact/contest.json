  "source": {
    "entry": "contest.ark",
    "files": {
      "contest.ark": "pragma arkade ^0.1.0;\n\nimport \"./rules.ark\";\n\ncontract CoinflipContest(\n  pubkey player,\n  bytes32 playerHash, bytes32 houseHash,\n  ScriptPubKey playerPayout, ScriptPubKey housePayout,\n  int playerStake, int houseStake,\n  int oddsN, int oddsLo, int oddsTarget,\n  int finalExpiration\n) {\n  @allow(unsigned-spend-path, \"both committed reveals determine the winner and the payout is pinned\")\n  function playerWin() {\n    int amount = CoinflipRules.pot(playerStake, houseStake);\n    require(CoinflipRules.playerWins(houseHash, playerHash, oddsN, oddsLo, oddsTarget), \"player did not win\");\n    CoinflipRules.pay(playerPayout, amount);\n  }\n\n  @allow(unsigned-spend-path, \"both committed reveals determine the winner and the payout is pinned\")\n  function creatorWin() {\n    int amount = CoinflipRules.pot(playerStake, houseStake);\n    require(!CoinflipRules.playerWins(houseHash, playerHash, oddsN, oddsLo, oddsTarget), \"house did not win\");\n    CoinflipRules.pay(housePayout, amount);\n  }\n\n  @allow(unsigned-spend-path, \"the matching player-signed CLTV leaf gates the pinned timeout payout\")\n  function playerTakeAll() {\n    int amount = CoinflipRules.pot(playerStake, houseStake);\n    CoinflipRules.pay(playerPayout, amount);\n  }\n\n  function playerTakeAll(signature playerSig, signature serverSig, signature emulatorSig) tapscript {\n    require(after(finalExpiration));\n    require(checkMultisig([player, server, emulator], [playerSig, serverSig, emulatorSig], 3));\n  }\n}\n",
      "rules.ark": "pragma arkade ^0.1.0;\n\nlibrary CoinflipRules {\n  function pot(int playerStake, int houseStake) int {\n    require(playerStake >= 330 && playerStake <= 2100000000000000, \"player stake\");\n    require(houseStake >= 330 && houseStake <= 2100000000000000, \"house stake\");\n    int amount = playerStake + houseStake;\n    require(amount <= 2100000000000000, \"pot limit\");\n    require(this.activeInputIndex == 0, \"pot must be input zero\");\n    require(tx.input.current.value == amount, \"pot value\");\n    return amount;\n  }\n\n  function playerWins(bytes32 houseHash, bytes32 playerHash, int n, int lo, int target) bool {\n    require(n >= 2 && n <= 128, \"odds denominator\");\n    require(lo >= 0 && lo < target && target <= n, \"odds interval\");\n    bytes playerReveal = tx.packet(16);\n    bytes houseReveal = tx.packet(17);\n    require(size(playerReveal) >= 17 && size(houseReveal) >= 17, \"reveal length\");\n    require(sha256(playerReveal) == playerHash, \"player commitment\");\n    require(sha256(houseReveal) == houseHash, \"house commitment\");\n    // A zero sign byte makes all 256 possible digit bytes unsigned.\n    int houseDigit = bin2num(cat(substr(houseReveal, 0, 1), 0x00));\n    int playerDigit = bin2num(cat(substr(playerReveal, 0, 1), 0x00));\n    if (houseDigit >= n) { return true; }\n    if (playerDigit >= n) { return false; }\n    int roll = (houseDigit + playerDigit) % n;\n    return roll >= lo && roll < target;\n  }\n\n  function pay(ScriptPubKey destination, int amount) {\n    require(tx.outputs[0].script == destination, \"payout destination\");\n    require(tx.outputs[0].value == amount, \"payout amount\");\n  }\n}\n"
    }
