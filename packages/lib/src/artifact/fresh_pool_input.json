  "source": {
    "entry": "fresh_pool_input.ark",
    "files": {
      "fresh_pool_input.ark": "pragma arkade ^0.1.0;\n\ncontract FreshPoolInput(bytes32 controlTxid, int controlGidx, bytes32 shareTxid, int shareGidx, int recoveryMargin) {\n  private function ownerPayout(pubkey owner, int inputIndex, int validUntil) ScriptPubKey {\n    require(controlGidx >= 0 && controlGidx <= 65535 && shareGidx >= 0 && shareGidx <= 65535, \"asset indices\");\n    require(controlTxid != shareTxid || controlGidx != shareGidx, \"distinct assets\");\n    require(recoveryMargin >= 2400 && recoveryMargin <= 33553920, \"recovery margin\");\n    bytes recorded = tx.inputs[inputIndex].packet(42);\n    bytes payout = tx.inputs[inputIndex].packet(43);\n    require(size(recorded) == 32 && recorded == owner, \"recorded owner\");\n    require(size(payout) == 33 && substr(payout, 0, 1) == 0x01, \"recorded payout\");\n    require(validUntil >= 500000000 && validUntil <= 4294967295 && !checkTime(validUntil), \"authorization deadline\");\n    require(checkTime(validUntil - 86400), \"authorization horizon\");\n    require(!tx.packet.has(42) && !tx.packet.has(43), \"no staged metadata\");\n    ScriptPubKey result = { version: 1, program: substr(payout, 1, 32) };\n    return result;\n  }\n\n  @allow(unsigned-spend-path, \"the authenticated owner signs the complete witness-masked transaction and authorization bounds\")\n  @allow(output-script-unchecked, \"the unchecked tail outputs carry zero value and every output is covered by the owner signature\")\n  function authorize(pubkey owner, signature ownerSig, int validUntil, int minTTL) {\n    require(this.activeInputIndex == 1 && tx.numInputs == 2 && tx.numOutputs == 4, \"paired pool funding\");\n    let payout = ownerPayout(owner, 1, validUntil);\n    require(payout != tx.inputs[0].script && payout != tx.inputs[1].script, \"owner payout differs\");\n    require(tx.inputs[0].assets.length == 1 && tx.inputs[0].assets.lookup(controlTxid, controlGidx) == 1, \"canonical pool control\");\n    let control = tx.assetGroups.find(controlTxid, controlGidx);\n    require(!control.isFresh && !control.hasControl && control.numInputs == 1 && control.sumInputs == 1, \"existing pool control\");\n    require(control.inputs[0].type == 1 && control.inputs[0].index == 0, \"local pool input\");\n    require(this.expiry >= 500000000 && this.expiry <= 4294967295, \"timestamp expiry\");\n    int minimumTTL = recoveryMargin + 3600;\n    if (minimumTTL < 6000) { minimumTTL = 6000; }\n    require(minTTL >= minimumTTL && minTTL <= 33557520 && !checkTime(this.expiry - minTTL), \"fresh member input\");\n    if (tx.packet.has(35)) {\n      bytes phase = tx.packet(35);\n      require(size(phase) == 1 && (phase == 0x00 || phase == 0x01), \"pool transition phase\");\n      require(control.numOutputs == 1 && control.sumOutputs == 1 && control.outputs[0].index == 0, \"pool continuation\");\n      if (phase == 0x01) {\n        bytes deadlines = tx.packet(40);\n        require(size(deadlines) == 10, \"game deadlines\");\n        int finalAt = bin2num(substr(deadlines, 5, 5));\n      require(finalAt >= 500000000 && finalAt <= 4294967295 - recoveryMargin && this.expiry >= finalAt + recoveryMargin, \"game recovery lifetime\");\n      }\n    } else {\n      require(control.numOutputs == 0 && control.sumOutputs == 0, \"retired control\");\n      require(!tx.packet.has(32) && !tx.packet.has(33) && !tx.packet.has(34), \"retired accounting\");\n      require(!tx.packet.has(36) && !tx.packet.has(37) && !tx.packet.has(38) && !tx.packet.has(39) && !tx.packet.has(40), \"retired game\");\n    }\n    require(tx.outputs[2].value == 0 && tx.outputs[3].value == 0, \"zero-value tail\");\n    bytes32 message = sha256(cat(\"coinflip/fresh-input/authorize/v1\", cat(sighash(1), cat(num2bin(validUntil, 5), num2bin(minTTL, 4)))));\n    require(checkSigFromStack(ownerSig, owner, message), \"owner authorization\");\n  }\n\n  @allow(unsigned-spend-path, \"the authenticated owner signs the complete witness-masked refund transaction and deadline\")\n  @allow(output-script-unchecked, \"the unchecked tail outputs carry zero value\")\n  function refund(pubkey owner, signature ownerSig, int validUntil) {\n    require(this.activeInputIndex == 0 && tx.numInputs == 1 && tx.numOutputs == 3, \"single staged refund\");\n    let payout = ownerPayout(owner, 0, validUntil);\n    require(tx.outputs[0].script == payout && tx.outputs[0].value == tx.inputs[0].value, \"complete owner refund\");\n    require(tx.inputs[0].value >= 330 && tx.outputs[1].value == 0 && tx.outputs[2].value == 0, \"refund carrier and tail\");\n    if (!tx.inputs[0].packet.has(0)) {\n      require(!tx.packet.has(0), \"plain refund\");\n    } else {\n      require(tx.inputs[0].assets.length == 1 && tx.outputs[0].assets.length == 1 && tx.assetGroups.length == 1, \"share refund shape\");\n      int held = tx.inputs[0].assets.lookup(shareTxid, shareGidx);\n      require(held > 0 && held <= 1000000000000 && tx.outputs[0].assets.lookup(shareTxid, shareGidx) == held, \"all staged shares\");\n      let shares = tx.assetGroups.find(shareTxid, shareGidx);\n      require(!shares.isFresh && !shares.hasControl && shares.numInputs == 1 && shares.numOutputs == 1, \"existing share transfer\");\n      require(shares.sumInputs == held && shares.sumOutputs == held, \"share conservation\");\n      require(shares.inputs[0].type == 1 && shares.inputs[0].index == 0 && shares.outputs[0].index == 0, \"refund asset destination\");\n    }\n    bytes32 message = sha256(cat(\"coinflip/fresh-input/refund/v1\", cat(sighash(1), num2bin(validUntil, 5))));\n    require(checkSigFromStack(ownerSig, owner, message), \"owner refund authorization\");\n  }\n}\n"
    }
