{
  "name": "coinflip",
  "version": "0.19.0",
  "private": true,
  "scripts": {
    "serve": "vite --host 0.0.0.0 --port 8080",
    "build:deps": "npm run build -w arkade-coinflip",
    "postinstall": "npm run build:deps && node scripts/copy-dice-assets.mjs",
    "prebuild": "npm run build:server && node scripts/copy-dice-assets.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint --ext .ts,.vue src",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "build:server": "npm run build:deps && npm run build -w arkade-coinflip-server",
    "test:packages": "npm run test -w arkade-coinflip-e2e",
    "test:packages:unit": "npm exec -w arkade-coinflip-e2e -- jest --runInBand --forceExit --testTimeout=30000 --testPathPattern=\\.unit\\.test\\.ts$",
    "preserve": "node scripts/copy-dice-assets.mjs",
    "contracts:build": "node scripts/compile-contracts.mjs",
    "contracts:check": "node scripts/compile-contracts.mjs --check",
    "regtest": "node scripts/regtest.mjs"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "^0.0.12",
    "@arkade-os/sdk": "0.5.4",
    "@scure/base": "^2.0.0",
    "@scure/bip39": "^2.0.1",
    "@scure/btc-signer": "^2.0.1",
    "arkade-coinflip": "0.3.20",
    "bech32": "^2.0.0",
    "core-js": "^3.31.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.2",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "vuex": "^4.1.0",
    "@arkade-os/swap": "0.1.4",
    "@arkade-os/lnurl-client": "0.9.2",
    "nostr-tools": "^2.24.1",
    "light-bolt11-decoder": "3.2.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@scure/bip32": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "eslint": "^8.42.0",
    "eslint-plugin-vue": "^9.14.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "sass": "^1.63.4",
    "vitest": "^4.1.8",
    "vite": "^8.3.8",
    "@vitejs/plugin-vue": "^6.0.10",
    "vue-tsc": "^3.3.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "workspaces": [
    "packages/lib",
    "packages/server",
    "packages/e2e"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "qs": "6.17.1",
    "brace-expansion@1": "1.1.22"
  }
}
