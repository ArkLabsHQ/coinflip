{
  "name": "arkade-coinflip",
  "version": "0.3.20",
  "description": "Trustless coinflip betting protocol for Ark",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./arkade-win": {
      "types": "./dist/arkade-win.d.ts",
      "import": "./dist/arkade-win.js",
      "require": "./dist/arkade-win.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "node ../../scripts/clean-dist.mjs lib"
  },
  "dependencies": {
    "@arkade-os/sdk": "0.5.4",
    "@noble/curves": "^2.0.1",
    "@scure/base": "^2.0.0",
    "@scure/btc-signer": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
