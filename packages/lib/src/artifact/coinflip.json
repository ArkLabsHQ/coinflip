      "coinflip.ark": "pragma arkade ^0.1.0;\n\nimport \"./rules.ark\";\nimport \"./contest.ark\";\n\ncontract CoinflipPot(\n  pubkey player, pubkey house,\n  bytes32 playerHash, bytes32 houseHash,\n  ScriptPubKey playerPayout, ScriptPubKey housePayout,\n  int playerStake, int houseStake,\n  int oddsN, int oddsLo, int oddsTarget,\n  int cancelDelay, int finalExpiration\n) {\n  @allow(unsigned-spend-path, \"both committed reveals determine the winner and the payout is pinned\")\n  function playerWin() {\n    int amount = CoinflipRules.pot(playerStake, houseStake);\n    require(CoinflipRules.playerWins(houseHash, playerHash, oddsN, oddsLo, oddsTarget), \"player did not win\");\n    CoinflipRules.pay(playerPayout, amount);\n  }\n\n  function playerWin(signature serverSig, signature emulatorSig) tapscript {\n    require(checkMultisig([server, emulator], [serverSig, emulatorSig], 2));\n  }\n\n  @allow(unsigned-spend-path, \"both committed reveals determine the winner and the payout is pinned\")\n  function creatorWin() {\n    int amount = CoinflipRules.pot(playerStake, houseStake);\n    require(!CoinflipRules.playerWins(houseHash, playerHash, oddsN, oddsLo, oddsTarget), \"house did not win\");\n    CoinflipRules.pay(housePayout, amount);\n  }\n\n  function creatorWin(signature serverSig, signature emulatorSig) tapscript {\n    require(checkMultisig([server, emulator], [serverSig, emulatorSig], 2));\n  }\n\n  @allow(unsigned-spend-path, \"the matching player-signed hashlock leaf authorizes the pinned contest continuation\")\n  function playerReveal() {\n    int amount = CoinflipRules.pot(playerStake, houseStake);\n    require(tx.outputs[0].script == new CoinflipContest(\n      player, playerHash, houseHash, playerPayout, housePayout,\n      playerStake, houseStake, oddsN, oddsLo, oddsTarget, finalExpiration\n    ), \"contest destination\");\n    require(tx.outputs[0].value == amount, \"contest amount\");\n  }\n\n  function playerReveal(bytes secret, signature playerSig, signature serverSig, signature emulatorSig) tapscript {\n    require(sha256(secret) == playerHash);\n    require(checkMultisig([player, server, emulator], [playerSig, serverSig, emulatorSig], 3));\n  }\n\n  @allow(unsigned-spend-path, \"the matching CLTV leaf gates refunds and both original stakes return to their committed destinations\")\n  function cooperativeSpend() {\n    int amount = CoinflipRules.pot(playerStake, houseStake);\n    require(cancelDelay < finalExpiration, \"deadline order\");\n    require(tx.outputs[0].script == playerPayout, \"player refund\");\n    require(tx.outputs[0].value == playerStake, \"player stake\");\n    require(tx.outputs[1].script == housePayout, \"house refund\");\n    require(tx.outputs[1].value == houseStake, \"house stake\");\n    require(tx.outputs[0].value + tx.outputs[1].value == amount, \"refund total\");\n  }\n\n  function cooperativeSpend(signature serverSig, signature emulatorSig) tapscript {\n    require(after(cancelDelay));\n    require(checkMultisig([server, emulator], [serverSig, emulatorSig], 2));\n  }\n\n  @allow(unsigned-spend-path, \"the matching hashlock and CSV leaf requires the player's signature\")\n  function playerForfeitExit() {\n    int amount = CoinflipRules.pot(playerStake, houseStake);\n    CoinflipRules.pay(playerPayout, amount);\n  }\n\n  function playerForfeitExit(bytes secret, signature playerSig, signature emulatorSig) tapscript {\n    require(sha256(secret) == playerHash);\n    require(older(serverExitDelay));\n    require(checkMultisig([player, emulator], [playerSig, emulatorSig], 2));\n  }\n\n  function playerWinExit(signature playerSig, signature emulatorSig) tapscript {\n    require(older(serverExitDelay));\n    require(checkMultisig([player, tweak(emulator, playerWin)], [playerSig, emulatorSig], 2));\n  }\n\n  function creatorWinExit(signature houseSig, signature emulatorSig) tapscript {\n    require(older(serverExitDelay));\n    require(checkMultisig([house, tweak(emulator, creatorWin)], [houseSig, emulatorSig], 2));\n  }\n\n  function cooperativeSpendExit(signature playerSig, signature houseSig) tapscript {\n    require(older(serverExitDelay));\n    require(checkMultisig([player, house], [playerSig, houseSig], 2));\n  }\n}\n",
      "contest.ark": "pragma arkade ^0.1.0;\n\nimport \"./rules.ark\";\n\ncontract CoinflipContest(\n  pubkey player,\n  bytes32 playerHash, bytes32 houseHash,\n  ScriptPubKey playerPayout, ScriptPubKey housePayout,\n  int playerStake, int houseStake,\n  int oddsN, int oddsLo, int oddsTarget,\n  int finalExpiration\n) {\n  @allow(unsigned-spend-path, \"both committed reveals determine the winner and the payout is pinned\")\n  function playerWin() {\n    int amount = CoinflipRules.pot(playerStake, houseStake);\n    require(CoinflipRules.playerWins(houseHash, playerHash, oddsN, oddsLo, oddsTarget), \"player did not win\");\n    CoinflipRules.pay(playerPayout, amount);\n  }\n\n  @allow(unsigned-spend-path, \"both committed reveals determine the winner and the payout is pinned\")\n  function creatorWin() {\n    int amount = CoinflipRules.pot(playerStake, houseStake);\n    require(!CoinflipRules.playerWins(houseHash, playerHash, oddsN, oddsLo, oddsTarget), \"house did not win\");\n    CoinflipRules.pay(housePayout, amount);\n  }\n\n  @allow(unsigned-spend-path, \"the matching player-signed CLTV leaf gates the pinned timeout payout\")\n  function playerTakeAll() {\n    int amount = CoinflipRules.pot(playerStake, houseStake);\n    CoinflipRules.pay(playerPayout, amount);\n  }\n\n  function playerTakeAll(signature playerSig, signature serverSig, signature emulatorSig) tapscript {\n    require(after(finalExpiration));\n    require(checkMultisig([player, server, emulator], [playerSig, serverSig, emulatorSig], 3));\n  }\n}\n",
      "rules.ark": "pragma arkade ^0.1.0;\n\nlibrary CoinflipRules {\n  function pot(int playerStake, int houseStake) int {\n    require(playerStake >= 330 && playerStake <= 2100000000000000, \"player stake\");\n    require(houseStake >= 330 && houseStake <= 2100000000000000, \"house stake\");\n    int amount = playerStake + houseStake;\n    require(amount <= 2100000000000000, \"pot limit\");\n    require(this.activeInputIndex == 0, \"pot must be input zero\");\n    require(tx.input.current.value == amount, \"pot value\");\n    return amount;\n  }\n\n  function playerWins(bytes32 houseHash, bytes32 playerHash, int n, int lo, int target) bool {\n    require(n >= 2 && n <= 128, \"odds denominator\");\n    require(lo >= 0 && lo < target && target <= n, \"odds interval\");\n    bytes playerReveal = tx.packet(16);\n    bytes houseReveal = tx.packet(17);\n    require(size(playerReveal) >= 17 && size(houseReveal) >= 17, \"reveal length\");\n    require(sha256(playerReveal) == playerHash, \"player commitment\");\n    require(sha256(houseReveal) == houseHash, \"house commitment\");\n    // A zero sign byte makes all 256 possible digit bytes unsigned.\n    int houseDigit = bin2num(cat(substr(houseReveal, 0, 1), 0x00));\n    int playerDigit = bin2num(cat(substr(playerReveal, 0, 1), 0x00));\n    if (houseDigit >= n) { return true; }\n    if (playerDigit >= n) { return false; }\n    int roll = (houseDigit + playerDigit) % n;\n    return roll >= lo && roll < target;\n  }\n\n  function pay(ScriptPubKey destination, int amount) {\n    require(tx.outputs[0].script == destination, \"payout destination\");\n    require(tx.outputs[0].value == amount, \"payout amount\");\n  }\n}\n"
    }
